{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Forma Audio Converter",
  "version": "0.1.2",
  "identifier": "com.egregoralabs.forma",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Forma Audio Converter",
        "width": 1180,
        "height": 860,
        "minWidth": 900,
        "minHeight": 840,
        "maxWidth": 1220,
        "maxHeight": 1000,
        "maximizable": false,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost data:; media-src 'self' http://forma-media.localhost blob:; connect-src ipc: http://ipc.localhost http://forma-media.localhost"
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/icon.ico"
    ]
  }
}
